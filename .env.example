# ══════════════════════════════════════════════════════════════
#  Gold Manager v2 — Environment Variables
#  Copia in .env e adatta ai valori locali.
#  Non committare mai .env su git.
# ══════════════════════════════════════════════════════════════

# ── Database principale (app) ──────────────────────────────────
DB_HOST=mariadb          # hostname del container MariaDB
DB_NAME=gold_manager     # nome del database
DB_USER=gm_user          # utente MySQL
DB_PASSWORD=secret       # password MySQL

# ── Database test (phpunit) ────────────────────────────────────
DB_HOST_TEST=mariadb
DB_PORT_TEST=3306
DB_NAME_TEST=gold_manager_test
DB_USER_TEST=gm_user
DB_PASSWORD_TEST=secret

# ── Redis ──────────────────────────────────────────────────────
REDIS_HOST=redis         # hostname del container Redis (queue Yii2)

# Yii2 cookie validation key (request component)
COOKIE_VALIDATION_KEY=3hCiLu7RxzT026pnS5zmw1fd4BLdbajl

# ══════════════════════════════════════════════════════════════
#  LLM / Commentary (SIP-0062)
# ══════════════════════════════════════════════════════════════

# Disabilita l'arricchimento LLM dei nomi all'avvio (entrypoint).
# Di default è abilitato: gira in background la prima volta che il DB è vuoto.
GM_DISABLE_NAME_ENRICHMENT=0

# Master switch: 0 = Ollama completamente disabilitato.
# Con 0, tutti i sotto-flag sotto vengono ignorati.
# I testi fallback vengono presi dalla tabella commentary_template.
GM_LLM_ENABLED=1

# Arricchimento asincrono degli eventi di partita (goal, save, ecc.)
# Disattivare per ridurre carico Ollama senza toccare il pre-partita.
GM_LLM_MATCH_ENRICH_ENABLED=1

# Testo lungo pre-partita generato da Ollama (atmosfera stadio, classifica).
# Più lento degli altri arricchimenti: disattivare in dev se Ollama è lento.
GM_LLM_PREMATCH_ENABLED=1

# Streaming token-per-token via SSE per l'effetto "typing".
# 0 = mostra il testo completo in una volta sola.
GM_COMMENTARY_STREAM_ENABLED=1

# 1 = usa suspense_text prima del reveal evento (gol/parata/palo).
# 0 = mostra subito il testo finale.
GM_SUSPENSE_ENABLED=1

# Ritardo (ms) tra suspense_text e reveal dell'esito (gol/parata/palo).
# Troppo basso = spoiler immediato. Troppo alto = attesa frustrante.
GM_SUSPENSE_DELAY_MS=3200

# Pausa (ms) tra chunk/token nello streaming dei template DB.
# Più basso = testo più rapido. Range utile: 60-300.
GM_TEMPLATE_STREAM_CHUNK_MS=150

# Modalità di split del testo template per lo streaming:
#   token  = parola per parola
#   clause = frase breve per frase breve
GM_TEMPLATE_STREAM_MODE=clause

# ══════════════════════════════════════════════════════════════
#  Gameplay / Feature Flags
# ══════════════════════════════════════════════════════════════

# 1 = salta al giorno/ora simulato (admin "advance day"). Solo dev.
GM_TEST_TIME_TRAVEL=0

# 1 = finestra trasferimenti sempre aperta (ignora mesi reali).
# Utile in dev/staging. In prod impostare 0 per rispettare il calendario.
GM_TRANSFER_ALWAYS_OPEN=1

# Numero massimo di amichevoli per team per settimana.
# 1000 = illimitato (dev). In prod suggerito: 1-2.
GM_MAX_FRIENDLIES_PER_WEEK=1

# Durata aste mercato (in ore).
# Giocatori pool: scadenza standard 48h.
GM_MARKET_PLAYER_AUCTION_HOURS=48
# Staff/Sponsor: scadenza ogni 2 giorni.
GM_MARKET_STAFF_AUCTION_HOURS=48
GM_MARKET_SPONSOR_AUCTION_HOURS=48

# Numero giocatori nel free-agent pool (lista mercato).
# Il cron mantiene il valore nel range [min,max] e punta al target.
GM_TRANSFER_POOL_MIN_PLAYERS=80
GM_TRANSFER_POOL_TARGET_PLAYERS=110
GM_TRANSFER_POOL_MAX_PLAYERS=140

# 1 = le amichevoli partono subito (match_date = now).
# 0 = rispettano l'orario slot configurato sotto.
GM_ENABLE_FRIENDLY_START_NOW=1

# Secondi di pre-partita prima del fischio d'inizio nelle amichevoli live.
# Durante questi secondi il Go worker mostra l'evento pre_match.
GM_PREMATCH_SECONDS=15

# Durata pausa intervallo del worker Go (in tick worker).
# Default legacy: 15 tick.
GM_HALF_TIME_TICKS=15

# Giorni della settimana (1=Lun…7=Dom) in cui si giocano le partite di campionato.
# Formato CSV. Default: mercoledì (3) e sabato (6).
GM_LEAGUE_MATCH_DAYS=3,6

# Giorno della settimana (1=Lun…7=Dom) per lo slot amichevoli.
GM_FRIENDLY_SLOT_DOW=4

# Ora (0-23) dello slot amichevoli (orario locale del server).
GM_FRIENDLY_SLOT_HOUR=15

# Probabilità (%) settimanale che una squadra CPU lanci una sfida amichevole.
GM_CPU_FRIENDLY_INIT_CHANCE=30

# Settimane di allenamento necessarie per salire di livello talent.
GM_TALENT_WEEKS_PER_LEVEL=26

# Probabilità base (%) per tick di crescita talent.
GM_TALENT_GROWTH_CHANCE_BASE=35

# Bonus massimo aggiuntivo (%) alla crescita talent per giocatori top.
GM_TALENT_GROWTH_CHANCE_MAX_BONUS=20
# Scala giornaliera crescita talenti (default = 1/7 del ritmo settimanale storico).
GM_TALENT_DAILY_SCALE=0.142857
# Scala giornaliera allenamento generale (default = 1/7 del ritmo settimanale storico).
GM_TRAINING_DAILY_SCALE=0.142857

# ══════════════════════════════════════════════════════════════
#  Security (SIP-0005)
# ══════════════════════════════════════════════════════════════

# Login brute-force guard (per IP + username).
GM_LOGIN_MAX_ATTEMPTS=8
GM_LOGIN_WINDOW_SECONDS=900
GM_LOGIN_BLOCK_SECONDS=900

# API rate limit (per user autenticato, finestra mobile).
GM_API_RATE_LIMIT=120
GM_API_RATE_WINDOW_SECONDS=60

# ══════════════════════════════════════════════════════════════
#  Cron (container gold-manager-cron)
# ══════════════════════════════════════════════════════════════

# Timezone per la pianificazione dei cron job.
CRON_TZ=Europe/Rome

# 0 = container cron avviato ma nessun job eseguito (utile per debug).
CRON_ENABLED=1

# Singoli job: 1=abilitato, 0=disabilitato.
CRON_ENABLE_PAY_WAGES=1        # stipendi + incassi settimanali
CRON_ENABLE_WEEKLY_RECOVERY=1  # recupero infortuni settimanale
CRON_ENABLE_DAILY_TRAINING=1   # effetti allenamento + snapshot statistiche
CRON_ENABLE_RUN_FIXTURES=1     # avvio partite programmate (ogni 5 min)
CRON_ENABLE_REFRESH_CPU_FORMATIONS=1  # auto-formazione squadre CPU (giornaliero)
CRON_ENABLE_RESOLVE_MARKET_AUCTIONS=1 # chiusura aste scadute (rolling)
CRON_ENABLE_NOTIFICATION_DISPATCH=1  # invio Telegram asincrono (SIP-0080)
CRON_ENABLE_PRE_MATCH_NOTIFICATIONS=1 # avviso 15 min prima del calcio d'inizio (SIP-0080)

# Schedule cron in formato crontab (override per dev/staging).
CRON_PAY_WAGES_SCHEDULE="0 0 * * *"          # mezzanotte ogni giorno
CRON_WEEKLY_RECOVERY_SCHEDULE="0 1 * * 1"    # lunedì 01:00
CRON_DAILY_TRAINING_SCHEDULE="0 2 * * *"     # ogni giorno 02:00
CRON_REFRESH_CPU_FORMATIONS_SCHEDULE="0 0 * * *" # ogni giorno 00:00
CRON_RUN_FIXTURES_SCHEDULE="*/5 * * * *"     # ogni 5 minuti
CRON_RESOLVE_MARKET_AUCTIONS_SCHEDULE="*/5 * * * *" # ogni 5 minuti
CRON_NOTIFICATION_DISPATCH_SCHEDULE="* * * * *"     # ogni minuto
CRON_PRE_MATCH_NOTIFICATIONS_SCHEDULE="* * * * *"   # ogni minuto
